; ADS-M-CROSS shared effective authority + DAG + evidence + release consistency.
(set-logic QF_UF)
(declare-sort Sha 0)
(declare-const currentHead Sha)
(declare-const ciHead Sha)
(declare-const reviewHead Sha)
(declare-const productFrozen Bool)
(declare-const dagFrozen Bool)
(declare-const claimAccepted Bool)
(declare-const builderAuthorized Bool)
(declare-const writeSetClear Bool)
(declare-const sourceMutation Bool)
(declare-const ciPass Bool)
(declare-const reviewPass Bool)
(declare-const closed Bool)
(declare-const released Bool)
(assert (=> dagFrozen productFrozen))
(assert (=> claimAccepted dagFrozen))
(assert (=> sourceMutation (and claimAccepted builderAuthorized writeSetClear)))
(assert (=> closed (and ciPass reviewPass claimAccepted
   (= currentHead ciHead) (= currentHead reviewHead))))
(assert (=> released (and productFrozen dagFrozen closed)))
; Cross-model negative challenges and legal release witness.
(push 1) (assert sourceMutation) (assert (not dagFrozen)) (check-sat) (pop 1)
(push 1) (assert released) (assert (not builderAuthorized))
  (assert sourceMutation) (check-sat) (pop 1)
(push 1) (assert released) (assert (distinct currentHead ciHead)) (check-sat) (pop 1)
(push 1) (assert released) (check-sat) (pop 1)
