; ADS-M-DEPENDENCY: finite four-node acyclic DAG by topological rank. NOT unbounded proof.
(set-logic QF_LIA)
(declare-const rA Int)
(declare-const rB Int)
(declare-const rC Int)
(declare-const rD Int)
(declare-const eAB Bool)
(declare-const eAC Bool)
(declare-const eAD Bool)
(declare-const eBA Bool)
(declare-const eBC Bool)
(declare-const eBD Bool)
(declare-const eCA Bool)
(declare-const eCB Bool)
(declare-const eCD Bool)
(declare-const eDA Bool)
(declare-const eDB Bool)
(declare-const eDC Bool)
(assert (=> eAB (< rA rB)))
(assert (=> eAC (< rA rC)))
(assert (=> eAD (< rA rD)))
(assert (=> eBA (< rB rA)))
(assert (=> eBC (< rB rC)))
(assert (=> eBD (< rB rD)))
(assert (=> eCA (< rC rA)))
(assert (=> eCB (< rC rB)))
(assert (=> eCD (< rC rD)))
(assert (=> eDB (< rD rB)))
(assert (=> eDC (< rD rC)))
(push 1) (assert eAB) (assert eBC) (assert eCD) (assert eDA) (check-sat) (pop 1)
