{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/agent-event-v2.schema.json",
  "title": "AI Development Agent Event v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "event", "actor_role", "operator_kind", "operator_id", "status"],
  "properties": {
    "schema": {"const": "ai-dev/event-v2"},
    "event": {
      "type": "string",
      "enum": ["ROLE_CLAIMED", "ROLE_RELEASED", "TASK_CLAIMED", "IMPLEMENTATION_READY", "REVIEW_DECISION", "REVIEW_RESULT", "FIX_APPLIED", "VALIDATION_REQUEST", "VALIDATION_RESULT", "BLOCKER_REPORTED", "DEPENDENCY_CHANGED", "MERGE_RESULT"]
    },
    "actor_role": {
      "type": "string",
      "enum": ["planner", "builder", "reviewer", "validator", "merge-controller", "release-controller"]
    },
    "operator_kind": {
      "type": "string",
      "enum": ["chatgpt-web", "codex", "claude-code", "human", "github-actions", "woodpecker", "other"]
    },
    "operator_id": {"type": "string", "minLength": 1},
    "session_ref": {"type": "string", "minLength": 1},
    "transport_actor": {"type": "string", "minLength": 1},
    "task": {"type": "string", "pattern": "^#[0-9]+$"},
    "pr": {"type": "string", "pattern": "^#[0-9]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "previous_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "review_policy": {"type": "string", "enum": ["required", "recommended", "not-required"]},
    "decision": {"type": "string", "enum": ["perform", "skipped", "not-applicable"]},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
    "next_state": {
      "type": "string",
      "enum": ["planned", "ready", "implementing", "review-ready", "reviewing", "changes-requested", "validation-needed", "merge-ready", "blocked", "done"]
    },
    "gate": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "exit_code": {"type": ["integer", "null"]},
    "evidence": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "addresses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "object", "additionalProperties": true},
    "findings": {"type": "object", "additionalProperties": true},
    "local_validation_required": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "IMPLEMENTATION_READY"}}, "required": ["event"]},
      "then": {"required": ["sha", "review_policy", "validation", "next_state"], "properties": {"actor_role": {"const": "builder"}}}
    },
    {
      "if": {"properties": {"event": {"const": "REVIEW_DECISION"}}, "required": ["event"]},
      "then": {
        "required": ["sha", "review_policy", "decision", "reason", "next_state"],
        "properties": {"actor_role": {"const": "merge-controller"}},
        "allOf": [
          {
            "if": {"properties": {"review_policy": {"const": "required"}}, "required": ["review_policy"]},
            "then": {
              "properties": {
                "decision": {"const": "perform"},
                "status": {"const": "NOT_RUN"},
                "next_state": {"const": "review-ready"}
              }
            }
          },
          {
            "if": {"properties": {"review_policy": {"const": "recommended"}}, "required": ["review_policy"]},
            "then": {
              "properties": {"decision": {"enum": ["perform", "skipped"]}, "status": {"const": "NOT_RUN"}},
              "allOf": [
                {
                  "if": {"properties": {"decision": {"const": "perform"}}, "required": ["decision"]},
                  "then": {"properties": {"next_state": {"const": "review-ready"}}}
                },
                {
                  "if": {"properties": {"decision": {"const": "skipped"}}, "required": ["decision"]},
                  "then": {"properties": {"next_state": {"const": "merge-ready"}}}
                }
              ]
            }
          },
          {
            "if": {"properties": {"review_policy": {"const": "not-required"}}, "required": ["review_policy"]},
            "then": {
              "properties": {
                "decision": {"const": "not-applicable"},
                "status": {"const": "NOT_APPLICABLE"},
                "next_state": {"const": "merge-ready"}
              }
            }
          }
        ]
      }
    },
    {
      "if": {"properties": {"event": {"const": "REVIEW_RESULT"}}, "required": ["event"]},
      "then": {"required": ["sha", "review_policy", "next_state"], "properties": {"actor_role": {"const": "reviewer"}}}
    },
    {
      "if": {"properties": {"event": {"const": "FIX_APPLIED"}}, "required": ["event"]},
      "then": {"required": ["sha", "previous_sha", "addresses", "next_state"], "properties": {"actor_role": {"const": "builder"}}}
    },
    {
      "if": {"properties": {"event": {"const": "VALIDATION_REQUEST"}}, "required": ["event"]},
      "then": {"required": ["sha", "gate", "environment", "reason", "next_state"]}
    },
    {
      "if": {"properties": {"event": {"const": "VALIDATION_RESULT"}}, "required": ["event"]},
      "then": {"required": ["sha", "gate", "environment", "command", "exit_code", "evidence", "next_state"], "properties": {"actor_role": {"const": "validator"}}}
    },
    {
      "if": {"properties": {"event": {"const": "MERGE_RESULT"}}, "required": ["event"]},
      "then": {"required": ["sha", "target", "next_state"], "properties": {"actor_role": {"const": "merge-controller"}}}
    }
  ]
}
