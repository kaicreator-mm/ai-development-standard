{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/execution-pack-manifest.schema.json",
  "title": "AI Development Execution Pack Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["pack_id", "task_id", "repository", "version", "base_sha", "task_pack_ref", "branch", "agent_freedom", "pinned_standard_revision", "generated_by", "generated_at", "core_artifacts", "retention"],
  "properties": {
    "pack_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "task_pack_ref": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "parent_issue": {"type": "string", "pattern": "^#[0-9]+$"},
    "pr": {"type": "string", "pattern": "^#[0-9]+$"},
    "agent_freedom": {"type": "string", "enum": ["F0_MECHANICAL", "F1_BOUNDED_IMPLEMENTATION", "F2_ENGINEERING_DISCRETION", "F3_ARCHITECTURE_REQUIRED"]},
    "pinned_standard_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "generated_by": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "dependency_completion": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[^@\\s]+@[0-9a-fA-F]{40}$"}
    },
    "material_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "core_artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "enum": ["MANIFEST.yaml", "EXECUTION_CONTRACT.md", "TEST_MATRIX.yaml", "FAILURE_MATRIX.yaml", "IMPLEMENTATION_MAP.md", "REVIEW_CHECKLIST.md"]
      }
    },
    "optional_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "retention": {"type": "string", "enum": ["durable", "transient", "full-provenance"]},
    "package_excluded": {"type": "boolean"},
    "pack_state_at_generation": {"type": "string", "const": "PACK_CURRENT"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"retention": {"const": "full-provenance"}},
        "required": ["retention"]
      },
      "then": {
        "required": ["package_excluded"],
        "properties": {"package_excluded": {"const": true}}
      }
    }
  ]
}
