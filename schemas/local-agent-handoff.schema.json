{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/local-agent-handoff.schema.json",
  "title": "AI Development Local Agent Handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["repository", "issue", "standard_revision", "integration_target", "baseline_sha", "role", "scope", "remaining_work", "required_gates", "validation_profile", "allowed_changes", "forbidden_changes", "completion_rule", "blocker_rule", "expected_output", "handoff_state"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "pattern": "^#[0-9]+$"},
    "standard_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "integration_target": {"type": "string", "minLength": 1},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "role": {"type": "string", "enum": ["builder", "reviewer", "validator"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "remaining_work": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_profile": {"type": "string", "minLength": 1},
    "allowed_changes": {"type": "array", "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "completion_rule": {"type": "string", "minLength": 1},
    "blocker_rule": {"type": "string", "minLength": 1},
    "expected_output": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "handoff_state": {"type": "string", "enum": ["DRAFT", "HANDOFF_READY", "DISPATCHED", "COMPLETED", "BLOCKED", "STALE"]},
    "dispatch_id": {"type": ["string", "null"]}
  }
}
