{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/task-contract.schema.json",
  "title": "AI Development Task Contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "goal", "integration_target", "baseline_sha", "review_policy", "required_gates", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "integration_target": {"type": "string", "minLength": 1},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "review_policy": {"type": "string", "enum": ["required", "recommended", "not-required"]},
    "validation_scope": {"type": "string", "enum": ["concern", "integration", "closure"]},
    "validation_owner": {"type": ["string", "null"]},
    "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "task_pack_ref": {"type": "string", "minLength": 1},
    "agent_freedom": {"type": "string", "enum": ["F0_MECHANICAL", "F1_BOUNDED_IMPLEMENTATION", "F2_ENGINEERING_DISCRETION", "F3_ARCHITECTURE_REQUIRED"]},
    "execution_pack": {"type": ["string", "null"], "minLength": 1},
    "jit_branch": {"type": ["boolean", "null"]},
    "l3_reference": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"agent_freedom": {"const": "F3_ARCHITECTURE_REQUIRED"}},
        "required": ["agent_freedom"]
      },
      "then": {
        "properties": {"review_policy": {"const": "required"}}
      }
    }
  ]
}
