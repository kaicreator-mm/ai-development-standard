{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/github-report-v2.schema.json",
  "title": "ADS GitHub Issue task report comment v2 — document locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_kind",
    "revision",
    "attempt_ref",
    "manifest_ref",
    "manifest_sha256",
    "coverage"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "report_kind": {
      "type": "string",
      "enum": [
        "EXECUTION_SUMMARY",
        "TASK_LEARNING",
        "EVIDENCE_UPDATE",
        "EXECUTION_CORRECTION"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_ref": {
      "type": "string",
      "minLength": 1
    },
    "manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "corrects_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
