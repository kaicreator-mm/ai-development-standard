{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kaicreator-mm.github.io/ai-development-standard/schemas/review-finding-v1.schema.json","title":"AI Development Review Finding v1","type":"object","additionalProperties":false,"required":["protocol_version","finding_id","assurance_id","subject_identity_ref","severity","summary","blocking","status","evidence_refs"],"properties":{"protocol_version":{"const":"ai-dev/review-finding-v1"},"finding_id":{"type":"string","minLength":1},"assurance_id":{"type":"string","minLength":1},"subject_identity_ref":{"type":"string","minLength":1},"severity":{"type":"string","enum":["P0","P1","P2","P3"]},"summary":{"type":"string","minLength":1},"blocking":{"type":"boolean"},"status":{"type":"string","enum":["OPEN","DISPOSITIONED","DUPLICATE","SUPERSEDED"]},"disposition":{"type":"string","minLength":1},"resolution_code":{"type":"string","enum":["FIXED","INVALIDATED_BY_EVIDENCE","DUPLICATE","SUPERSEDED","ACCEPTED","DEFERRED","NOT_APPLICABLE"]},"duplicate_of":{"type":"string","minLength":1},"superseded_by":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}},"allOf":[{"if":{"properties":{"severity":{"enum":["P0","P1"]}},"required":["severity"]},"then":{"properties":{"blocking":{"const":true}}}},{"if":{"properties":{"severity":{"enum":["P0","P1"]},"status":{"const":"DISPOSITIONED"}},"required":["severity","status"]},"then":{"required":["resolution_code","disposition"],"properties":{"resolution_code":{"enum":["FIXED","INVALIDATED_BY_EVIDENCE"]}}}},{"if":{"properties":{"status":{"const":"DUPLICATE"}},"required":["status"]},"then":{"required":["resolution_code","duplicate_of","disposition"],"properties":{"resolution_code":{"const":"DUPLICATE"}}}},{"if":{"properties":{"status":{"const":"SUPERSEDED"}},"required":["status"]},"then":{"required":["resolution_code","superseded_by","disposition"],"properties":{"resolution_code":{"const":"SUPERSEDED"}}}}]}
