{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/migration-transition-v1.schema.json",
  "title": "AI Development Migration Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "source_state_ref", "target_state_ref", "mechanism_refs", "applicability", "recovery", "validation_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "source_state_ref": {"type": "string", "minLength": 1},
    "target_state_ref": {"type": "string", "minLength": 1},
    "mechanism_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "ordered_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action_ref"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "action_ref": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "dependency_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datastore_kind"],
      "properties": {
        "datastore_kind": {"type": "string", "minLength": 1},
        "runtime_or_version": {"type": ["string", "null"], "minLength": 1},
        "environment_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "risk_class": {"type": ["string", "null"], "minLength": 1},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_class", "strategy_ref", "prerequisites"],
      "properties": {
        "strategy_class": {"type": "string", "minLength": 1},
        "strategy_ref": {"type": "string", "minLength": 1},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "validation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
