{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/dag-mutation-record-v1.schema.json",
  "title": "AI Development DAG Mutation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mutation_id",
    "mutation_class",
    "requested_by",
    "approved_by",
    "reason",
    "affected_task_refs",
    "old_topology_ref",
    "new_topology_ref",
    "old_edges",
    "new_edges",
    "scope_impact",
    "release_impact",
    "task_pack_impact_refs",
    "review_impact",
    "validation_impact_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mutation_id": {"type": "string", "minLength": 1},
    "mutation_class": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "affected_task_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "old_topology_ref": {"type": "string", "minLength": 1},
    "new_topology_ref": {"type": "string", "minLength": 1},
    "old_edges": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "new_edges": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "scope_impact": {"type": "string", "minLength": 1},
    "release_impact": {"type": "string", "minLength": 1},
    "task_pack_impact_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "review_impact": {"type": "string", "minLength": 1},
    "validation_impact_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "notes_ref": {"type": "string", "minLength": 1}
  }
}
