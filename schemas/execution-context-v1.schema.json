{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/execution-context-v1.schema.json",
  "title": "AI Development Execution Context v1",
  "description": "Non-authoritative projection of material facts about a requested or observed execution. This contract does not own workflow, Gate, Review, Candidate, Release, or repository-integration state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "task": {"type": ["string", "null"], "minLength": 1},
        "issue": {"type": ["string", "null"], "pattern": "^#[0-9]+$"},
        "pr": {"type": ["string", "null"], "pattern": "^#[0-9]+$"}
      }
    },
    "source_workspace": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "workspace_id": {"type": ["string", "null"], "minLength": 1},
        "branch_ref": {"type": ["string", "null"], "minLength": 1},
        "materialization": {"type": ["string", "null"], "minLength": 1},
        "working_tree_clean": {"type": ["boolean", "null"]}
      }
    },
    "dependency_toolchain": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "profile_ref": {"type": ["string", "null"], "minLength": 1},
        "manifest_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "lock_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "observed_runtime_toolchain": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "configuration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "profile_ref": {"type": ["string", "null"], "minLength": 1},
        "non_secret_fingerprint": {"type": ["string", "null"], "minLength": 1},
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref"],
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "source": {"type": ["string", "null"], "minLength": 1},
              "scope": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "relevant": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "identity"],
            "properties": {
              "class": {
                "type": "string",
                "enum": ["SOURCE", "GENERATED_SOURCE", "BUILD_OUTPUT", "CACHE", "RUNTIME_STATE", "TEST_ARTIFACT", "VALIDATION_EVIDENCE", "RELEASE_ARTIFACT", "SECRET_MATERIAL"]
              },
              "identity": {"type": "string", "minLength": 1},
              "ref": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "external_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "dependency_fidelity", "environment_class", "side_effect_authority"],
        "properties": {
          "system_id": {"type": "string", "minLength": 1},
          "dependency_fidelity": {"type": "string", "minLength": 1},
          "environment_class": {"type": "string", "minLength": 1},
          "environment_ref": {"type": ["string", "null"], "minLength": 1},
          "state_scope": {"type": ["string", "null"], "minLength": 1},
          "side_effect_authority": {"type": "string", "minLength": 1},
          "credential_ref": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "executor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["host_role"],
      "properties": {
        "host_role": {"type": "string", "minLength": 1},
        "environment_ref": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
