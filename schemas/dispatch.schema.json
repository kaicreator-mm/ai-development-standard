{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/dispatch.schema.json",
  "title": "AI Development Canonical Dispatch",
  "description": "Executable handoff for builder/validator/reviewer pull workers. One dispatch architecture; role and execution_profile configure authority. Pull vocabulary READY/CLAIMED/RUNNING/COMPLETED/BLOCKED/SUPERSEDED aliases the v3.3 lifecycle vocabulary (QUEUED/ACKNOWLEDGED/DONE/STALE). Optional parent_dispatch_ref and responsibility_mode are the additive same-family responsibility projection of EXECUTION_ARCHITECTURE_STANDARD.md section 28 (delegated subwork / responsibility handoff): they create no authority, name no second lifecycle, and reconstruct ambiguity fails closed.",
  "type": "object",
  "additionalProperties": true,
  "required": ["dispatch_id", "repository", "version", "task", "role", "execution_profile", "branch", "expected_base_sha", "pinned_standard_revision", "agent_freedom", "dispatch_state"],
  "properties": {
    "dispatch_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "issue": {"type": "string", "pattern": "^#[0-9]+$"},
    "pr": {"type": "string", "pattern": "^#[0-9]+$"},
    "role": {"type": "string", "enum": ["builder", "validator", "reviewer"]},
    "execution_profile": {"type": "string", "enum": ["LOCAL_BUILDER", "LOCAL_VALIDATOR", "WEB_REVIEWER", "PLATFORM_VALIDATOR", "CLOSURE_VALIDATOR"]},
    "branch": {"type": "string", "minLength": 1},
    "expected_base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "requested_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "task_pack_ref": {"type": ["string", "null"], "minLength": 1},
    "execution_pack_ref": {"type": ["string", "null"], "minLength": 1},
    "execution_context_requirements_ref": {"type": ["string", "null"], "minLength": 1},
    "dependency_toolchain_profile_ref": {"type": ["string", "null"], "minLength": 1},
    "validation_profile": {"type": ["string", "null"], "minLength": 1},
    "pinned_standard_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "agent_freedom": {"type": "string", "enum": ["F0_MECHANICAL", "F1_BOUNDED_IMPLEMENTATION", "F2_ENGINEERING_DISCRETION", "F3_ARCHITECTURE_REQUIRED"]},
    "dispatch_state": {"type": "string", "enum": ["READY", "CLAIMED", "RUNNING", "COMPLETED", "BLOCKED", "SUPERSEDED"]},
    "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "superseded_reason": {"type": "string", "minLength": 1},
    "queue_ref": {"type": ["string", "null"], "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "claimed_by": {"type": ["string", "null"], "minLength": 1},
    "parent_dispatch_ref": {"type": ["string", "null"], "minLength": 1},
    "responsibility_mode": {"type": "string", "enum": ["DELEGATED_SUBWORK", "RESPONSIBILITY_HANDOFF"]},
    "execution_environment": {"type": "string", "enum": ["WEB", "LOCAL"], "description": "Coarse execution environment (WEB | LOCAL). Environment never implies authority and never substitutes for role, eligibility, capability, independence, exact-subject currentness or authorization. Provider/model identity is operator/capability provenance only (#861 bounded refinement)."},
    "compatibility_group": {"type": ["string", "null"], "minLength": 1, "description": "Optional non-default compatibility group participating in the derived protected claim key (slot 4 after normalization). Null/omitted means the __default__ group."},
    "compatibility_authority_ref": {"type": ["string", "null"], "minLength": 1, "description": "Durable resolvable higher-authority validation reference authorizing the non-default compatibility group. Required whenever compatibility_group is a non-default string (blank-only strings normalize to the reserved __default__ group and need no ref); never downgraded to the __default__ group. The durable ref shape alone never authorizes: the ref must resolve at the admission/conformance boundary to a current controller-resolved grant of the owning authority family applicable to the exact repository+task+role+group tuple."},
    "admission_generation": {"type": ["integer", "null"], "minimum": 0, "description": "Monotonic per-claim-key admission generation for CAS (non-negative integer, schema-enforced minimum 0). Reserve moves g to g+1; claim requires the current value; a stale value resolves STALE with zero canonical mutation; terminal states never decrement."},
    "scheduler_origin": {"type": "string", "enum": ["WEB", "LOCAL"], "description": "Request/writer provenance of the scheduling origin only. Never an input to the protected claim key, eligibility, or any authority decision."}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "validator"}}, "required": ["role"]},
      "then": {"required": ["requested_head_sha", "validation_profile"]}
    },
    {
      "if": {"properties": {"role": {"const": "reviewer"}}, "required": ["role"]},
      "then": {"required": ["pr"]}
    },
    {
      "if": {"properties": {"role": {"const": "builder"}}, "required": ["role"]},
      "then": {"required": ["task_pack_ref"]}
    },
    {
      "if": {"properties": {"dispatch_state": {"const": "COMPLETED"}}, "required": ["dispatch_state"]},
      "then": {"required": ["result"]}
    },
    {
      "if": {"properties": {"dispatch_state": {"const": "SUPERSEDED"}}, "required": ["dispatch_state"]},
      "then": {"required": ["superseded_reason"]}
    },
    {
      "if": {"properties": {"dispatch_state": {"enum": ["CLAIMED", "RUNNING"]}}, "required": ["dispatch_state"]},
      "then": {"required": ["claimed_by"]}
    },
    {
      "if": {"properties": {"execution_profile": {"enum": ["LOCAL_VALIDATOR", "PLATFORM_VALIDATOR", "CLOSURE_VALIDATOR"]}}, "required": ["execution_profile"]},
      "then": {"properties": {"role": {"const": "validator"}}}
    },
    {
      "if": {"properties": {"execution_profile": {"const": "LOCAL_BUILDER"}}, "required": ["execution_profile"]},
      "then": {"properties": {"role": {"const": "builder"}}}
    },
    {
      "if": {"properties": {"execution_profile": {"const": "WEB_REVIEWER"}}, "required": ["execution_profile"]},
      "then": {"properties": {"role": {"const": "reviewer"}}}
    },
    {
      "if": {"properties": {"responsibility_mode": {"const": "DELEGATED_SUBWORK"}}, "required": ["responsibility_mode"]},
      "then": {"required": ["created_by", "parent_dispatch_ref"]}
    },
    {
      "if": {"properties": {"responsibility_mode": {"const": "RESPONSIBILITY_HANDOFF"}}, "required": ["responsibility_mode"]},
      "then": {"required": ["created_by"]}
    },
    {
      "if": {"properties": {"compatibility_group": {"type": "string", "minLength": 1}}, "required": ["compatibility_group"]},
      "then": {
        "if": {"properties": {"compatibility_group": {"pattern": "^\\s*$"}}},
        "then": {},
        "else": {
          "if": {"properties": {"compatibility_group": {"const": "__default__"}}},
          "then": {},
          "else": {"required": ["compatibility_authority_ref"]}
        }
      }
    }
  ]
}
