{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/intent-assumption-record-v1.schema.json",
  "title": "AI Development Intent / Assumption Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "repository",
    "subject_ref",
    "classification",
    "content_ref",
    "created_by_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "classification": {
      "type": "string",
      "enum": [
        "USER_INTENT",
        "INTERPRETATION",
        "ASSUMPTION",
        "UNKNOWN",
        "DECISION_REQUIRED",
        "DURABLE_REQUIREMENT"
      ]
    },
    "content_ref": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "promotion_authority_ref": {"type": "string", "minLength": 1},
    "promoted_requirement_ref": {"type": "string", "minLength": 1},
    "created_by_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"classification": {"const": "DURABLE_REQUIREMENT"}},
        "required": ["classification"]
      },
      "then": {
        "required": ["promotion_authority_ref", "promoted_requirement_ref"]
      }
    }
  ]
}
