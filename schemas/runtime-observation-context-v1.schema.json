{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/runtime-observation-context-v1.schema.json",
  "title": "AI Development Runtime Observation Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "artifact_ref",
    "deployment_ref",
    "environment_ref",
    "observation_window",
    "signal_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "artifact_ref": {"type": "string", "minLength": 1},
    "deployment_ref": {"type": "string", "minLength": 1},
    "environment_ref": {"type": "string", "minLength": 1},
    "component_or_scope_ref": {"type": "string", "minLength": 1},
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ref", "end_ref"],
      "properties": {
        "start_ref": {"type": "string", "minLength": 1},
        "end_ref": {"type": "string", "minLength": 1}
      }
    },
    "signal_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "signal_classes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "configuration_profile_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
