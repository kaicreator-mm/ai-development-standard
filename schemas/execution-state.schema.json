{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/execution-state.schema.json",
  "title": "AI Development Derived Execution State",
  "type": "object",
  "additionalProperties": true,
  "required": ["repository", "work_item", "workflow_state", "ready_queues", "derived_from"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "work_item": {"type": "string", "minLength": 1},
    "current_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "current_target_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "workflow_state": {"type": "string", "enum": ["planned", "ready", "implementing", "review-ready", "reviewing", "changes-requested", "validation-needed", "merge-ready", "blocked", "done"]},
    "review_policy": {"type": ["string", "null"], "enum": ["required", "recommended", "not-required", null]},
    "provider_state": {"type": ["string", "null"], "enum": ["AVAILABLE", "INFRA_BLOCKED", "TIMED_OUT", "CANCELLED", null]},
    "candidate_state": {"type": ["string", "null"], "enum": ["PREPARED", "FROZEN", "THAWED", "INVALIDATED", null]},
    "release_state": {"type": ["string", "null"], "enum": ["NOT_READY", "READY", "CONDITIONAL", "BLOCKED", "FAIL", null]},
    "active_dispatch": {"type": ["string", "null"]},
    "active_dispatch_role": {"type": ["string", "null"], "enum": ["builder", "validator", "reviewer", null]},
    "dispatch_state": {"type": ["string", "null"], "enum": ["READY", "CLAIMED", "RUNNING", "COMPLETED", "BLOCKED", "SUPERSEDED", null]},
    "execution_pack_state": {"type": ["string", "null"], "enum": ["PACK_CURRENT", "PACK_STALE_NONMATERIAL", "PACK_STALE_MATERIAL", "PACK_INVALID", null]},
    "expected_base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "requested_head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "queue_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stale_evidence": {"type": "array", "items": {"type": "string"}},
    "stale_dispatch": {"type": "array", "items": {"type": "string"}},
    "active_dispatches": {"type": "array", "description": "NON_AUTHORITATIVE_DERIVED_STATE projection of currently active dispatches for this work item. Legacy singular active_dispatch/active_dispatch_role remain readable: when more than one entry is present they MUST be null/omitted (no arbitrary primary). Rows are stably sorted by derived protected claim key then dispatch_id; rows carry the exact subject refs (issue/pr) of their dispatch when present; this projection never creates or carries authority.", "items": {"type": "object", "additionalProperties": false, "required": ["dispatch_id", "role"], "properties": {"dispatch_id": {"type": "string", "minLength": 1}, "role": {"type": "string", "enum": ["builder", "validator", "reviewer"]}, "execution_environment": {"type": ["string", "null"], "enum": ["WEB", "LOCAL", null]}, "compatibility_group": {"type": ["string", "null"], "minLength": 1}, "protected_claim_key": {"type": "string", "minLength": 1}, "claimed_by": {"type": ["string", "null"], "minLength": 1}, "issue": {"type": ["string", "null"], "pattern": "^#[0-9]+$"}, "pr": {"type": ["string", "null"], "pattern": "^#[0-9]+$"}}}},
    "ready_queues": {"type": "array", "items": {"type": "string", "enum": ["builder", "reviewer", "validator", "merge", "release", "human-decision"]}},
    "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"release_state": {"enum": ["READY", "CONDITIONAL", "BLOCKED", "FAIL"]}},
        "required": ["release_state"]
      },
      "then": {
        "required": ["candidate_state"],
        "properties": {"candidate_state": {"const": "FROZEN"}}
      }
    }
  ]
}
