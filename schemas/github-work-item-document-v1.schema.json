{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/github-work-item-document-v1.schema.json",
  "title": "ADS Work Item Document v1 — opt-in Markdown/YAML issue contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_type",
    "contract"
  ],
  "properties": {
    "schema_version": {
      "const": "ads/work-item/v1"
    },
    "work_item_type": {
      "type": "string",
      "enum": [
        "type:version",
        "type:planning",
        "type:research",
        "type:research-demo",
        "type:task",
        "type:bug",
        "type:fix",
        "type:validation",
        "type:blocker",
        "type:release"
      ]
    },
    "contract": {
      "type": "object"
    }
  }
}
