{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/maintenance-policy-v1.schema.json",
  "title": "AI Development Maintenance Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "product_or_component_ref",
    "support_lines"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "product_or_component_ref": {"type": "string", "minLength": 1},
    "support_lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "baseline_ref",
          "support_state",
          "allowed_change_classes",
          "authority_ref"
        ],
        "properties": {
          "line_id": {"type": "string", "minLength": 1},
          "baseline_ref": {"type": "string", "minLength": 1},
          "support_state": {"type": "string", "minLength": 1},
          "allowed_change_classes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "authority_ref": {"type": "string", "minLength": 1},
          "effective_from": {"type": "string", "minLength": 1},
          "effective_until": {"type": "string", "minLength": 1},
          "upgrade_or_migration_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "backport_source_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "result_sha_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "validation_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "review_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "release_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
