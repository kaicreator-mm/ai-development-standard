{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/task-learning-v1.schema.json",
  "title": "AI Development Task Learning Evidence v1",
  "description": "Compact, non-authoritative reusable implementation learning bound to work identity and evidence. TASK_LEARNING=NONE_MATERIAL is represented by absence of this object, not an empty record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learning_id",
    "repository_ref",
    "work_item_ref",
    "authority_refs",
    "summary",
    "source_test_validation_review_refs",
    "confidence_layers",
    "disposition"
  ],
  "properties": {
    "schema_version": {"const": "ai-dev/task-learning-v1"},
    "learning_id": {"type": "string", "minLength": 1},
    "repository_ref": {"type": "string", "minLength": 1},
    "work_item_ref": {"type": "string", "minLength": 1},
    "implementation_subject_ref": {"type": "string", "minLength": 1},
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string", "minLength": 1},
    "rationale_summary": {"type": "string", "minLength": 1},
    "unexpected_constraint_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "task_pack_or_l3_clarification_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reusable_invariant_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "known_limitation_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_test_validation_review_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "confidence_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["IDENTITY_BOUND", "BEHAVIOR_SUPPORTED", "INDEPENDENTLY_CHALLENGED"]
      }
    },
    "friction_classification": {
      "type": "string",
      "enum": [
        "PROJECT_DEFECT",
        "AGENT_EXECUTION_DEFECT",
        "ENVIRONMENT_OR_TOOL_DEFECT",
        "PROJECT_SPECIFIC_REQUIREMENT",
        "STANDARD_FRICTION_CANDIDATE",
        "ADS_EVOLUTION_CANDIDATE"
      ]
    },
    "currentness_ref": {"type": "string", "minLength": 1},
    "disposition": {"type": "string", "minLength": 1}
  }
}
