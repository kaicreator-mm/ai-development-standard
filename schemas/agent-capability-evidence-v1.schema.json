{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/agent-capability-evidence-v1.schema.json",
  "title": "AI Development Agent Capability Evidence v1",
  "description": "Historical exact-subject positive or negative capability evidence. It never implies current Availability, Validation, Review, authority or universal economic benefit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "logical_operator_or_executor_ref", "task_class_or_capability_class", "role", "exact_subject_ref", "result_refs", "evidence_strength", "observed_at_or_currentness_scope", "observation_kind"],
  "properties": {
    "schema_version": {"const": "ai-dev/agent-capability-evidence-v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "agent_profile_ref": {"type": "string", "minLength": 1},
    "logical_operator_or_executor_ref": {"type": "string", "minLength": 1},
    "provider_model_provenance": {"type": "string", "minLength": 1},
    "task_class_or_capability_class": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "exact_subject_ref": {
      "type": "string",
      "pattern": "^git:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$"
    },
    "environment_ref": {"type": "string", "minLength": 1},
    "runner_or_resource_capability_ref": {"type": "string", "minLength": 1},
    "task_pack_execution_pack_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "result_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "observed_findings_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "measured_resource_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_strength": {"type": "string", "enum": ["IDENTITY_BOUND", "BEHAVIOR_SUPPORTED", "INDEPENDENTLY_CHALLENGED"]},
    "observed_at_or_currentness_scope": {"type": "string", "minLength": 1},
    "observation_kind": {"type": "string", "enum": ["POSITIVE", "NEGATIVE", "MIXED"]},
    "economic_measurement_status": {"type": "string", "enum": ["NOT_MEASURED", "MEASURED_COMPARABLE", "MEASURED_NONCOMPARABLE"]}
  }
}
