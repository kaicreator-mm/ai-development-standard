{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/dependency-toolchain-profile-v1.schema.json",
  "title": "AI Development Dependency & Toolchain Profile v1",
  "description": "Optional durable repository/project contract for dependency graph and toolchain requirements. Compatibility, preferred development, certification, and deployment identities are distinct facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "repository", "manifests", "toolchains", "certification_tuples"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "authority"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "dependency_class_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "lock_or_resolution_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "minLength": 1},
          "content_identity": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "dependency_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["runtime", "development", "build", "test", "optional", "platform", "transitive", "other"]
      }
    },
    "toolchains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "compatibility"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "compatibility": {"type": "string", "minLength": 1},
          "supported_lines": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "preferred_development": {"type": ["string", "null"], "minLength": 1},
          "deployment_identity": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "certification_tuples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolchain", "version", "platform", "validation_profile"],
        "properties": {
          "toolchain": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "validation_profile": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "package_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "provenance_policy": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "change_policy": {"type": ["string", "null"], "minLength": 1},
    "eol_policy": {"type": ["string", "null"], "minLength": 1},
    "license_policy": {"type": ["string", "null"], "minLength": 1},
    "sbom_policy": {"type": ["string", "null"], "minLength": 1}
  }
}
