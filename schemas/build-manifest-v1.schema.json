{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/ai-development-standard/schemas/build-manifest-v1.schema.json",
  "title": "AI Development Build Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "source_identity",
    "build_profile",
    "entrypoint_or_command_ref",
    "builder_ref",
    "toolchain_refs",
    "outputs",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "build_id": {"type": "string", "minLength": 1},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "tree_or_digest_ref": {"type": "string", "minLength": 1}
      }
    },
    "build_profile": {"type": "string", "minLength": 1},
    "entrypoint_or_command_ref": {"type": "string", "minLength": 1},
    "builder_ref": {"type": "string", "minLength": 1},
    "toolchain_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_profile_ref": {"type": "string", "minLength": 1},
    "non_secret_config_fingerprint": {"type": "string", "minLength": 1},
    "generated_input_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "platform_ref": {"type": "string", "minLength": 1},
    "architecture_ref": {"type": "string", "minLength": 1},
    "feature_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "platform_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
